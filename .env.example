# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=

# Optional (defaults shown).
# MEDRA_DEEPSEEK_MODEL=deepseek-flash
# MEDRA_MAX_TOKENS=8192
# MEDRA_LIVE_DISABLED=0              # 1 = kill switch: no DeepSeek or Ollama sessions
# MEDRA_OLLAMA_URL=http://127.0.0.1:11434
# MEDRA_OLLAMA_MODEL=deepseek-r1:8b

# Deployment: scripts/deploy_cloudrun.py --secrets copies this to the server as MEDRA_ACCESS_CODES
# (code:n = n DeepSeek sessions per UTC day). A different name, so local runs ask for no code.
# MEDRA_DEPLOY_ACCESS_CODES=code1:40,code2:20
